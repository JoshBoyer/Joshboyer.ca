{
  "name": "joshboyer-ca",
  "version": "1.0.0",
  "private": true,
  "description": "Josh Boyer's imported portfolio and preserved career knowledge",
  "scripts": {
    "start": "node serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node tools/check-syntax.cjs",
    "lint": "eslint .",
    "audit:dependencies": "npm audit",
    "check:security": "node tools/security-check.cjs",
    "build:chat-knowledge": "node tools/build-chat-knowledge.cjs",
    "check:chat-knowledge": "node tools/build-chat-knowledge.cjs --check",
    "build": "npm run check && npm run check:security && npm run check:chat-knowledge && node tools/build-manifest.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
