{
  "name": "josh-boyer-portfolio",
  "account_id": "019f6ca21aafa442ceed0e09bdf76f7f",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "send_email": [
    {
      "name": "CONTACT_MAILER",
      "allowed_sender_addresses": [
        "noreply@joshboyer.ca"
      ]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO_STATE",
        "class_name": "PortfolioState"
      }
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*-knowledge.txt"
      ],
      "fallthrough": true
    }
  ],
  "exports": {
    "PortfolioState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "EXPLORE_AI_ENABLED": "false"
  }
}