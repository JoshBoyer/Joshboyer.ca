{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshboyer-chat-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": "./build/assets", "binding": "CHAT_ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "vars": { "AWS_ORIGIN": "https://7fvk4i6eg7.execute-api.us-east-2.amazonaws.com/dev", "CHAT_PRIVATE_ENABLED": "true", "PUBLIC_CHAT_ENABLED": "false", "PROBE_ENABLED": "false" }
}
